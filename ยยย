local isScoped = false
scopeBtn.MouseButton1Click:Connect(function()
    isScoped = not isScoped
    if isScoped then
        scopeBtn.BackgroundColor3 = Color3.fromRGB(100, 40, 150)
        print("เปิดสโคปปืนแล้ว")
    else
        scopeBtn.BackgroundColor3 = Color3.fromRGB(60, 40, 100)
        print("ปิดสโคปปืนแล้ว")
    end
end)

-- ตรวจสอบรหัสผ่าน
submitBtn.MouseButton1Click:Connect(function()
    if passBox.Text == correctPassword then
        loginContainer.Visible = false
        contentContainer.Visible = true
    else
        passBox.Text = ""
        passBox.PlaceholderText = "รหัสผ่านไม่ถูกต้อง!"
    end
end)

-- ระบบปิด/เปิดย่อหน้าต่างเมนู
local isOpen = true
toggleBtn.MouseButton1Click:Connect(function()
    isOpen = not isOpen
    sideBar.Visible = isOpen
    searchBar.Visible = isOpen
    if loginContainer.Visible then
        loginContainer.Visible = isOpen
    end
    if contentContainer.Visible then
        contentContainer.Visible = isOpen
    end
    
    if isOpen then
        toggleBtn.Text = "-"
        mainFrame.Size = UDim2.new(0, 480, 0, 320)
    else
        toggleBtn.Text = "+"
        mainFrame.Size = UDim2.new(0, 480, 0, 50)
    end
end)

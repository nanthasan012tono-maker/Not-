end

if footTagOn then
    local tag = char:FindFirstChild("JackFootTag")
    if tag then
        local txt
        if #items == 0 then
            txt = "📦 ไม่มีของโชว์"
        else
            -- ใส่ได้สูงสุด 5 ชิ้น สีตาม rarity ของแต่ละชิ้น

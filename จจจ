        Name = "TagText",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        RichText = true,
        Text = "...",
        TextStrokeTransparency = 0,
        TextSize = 12, Font = FONT,
    }, bg)
end

if headTagOn then
    local tag = head and head:FindFirstChild("JackHeadTag")
    if tag then
        local txt = "👤 ไม่มีของโชว์"
        if best then
            txt = "👑 " .. '<font color="#' .. best.hex .. '">'
                .. escRich(best.name) .. "</font>"
        end
        if lastHeadTexts[p.Name] ~= txt then
            lastHeadTexts[p.Name] = txt
            tag.TagText.Text = txt
        end
    end
end


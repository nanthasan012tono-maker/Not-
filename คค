local isEspActive = false
local espConnections = {}
local healthBarLoops = {}

espBtn.MouseButton1Click:Connect(function()
    isEspActive = not isEspActive
    if isEspActive then
        espBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        
        local function applyESP(p)
            if p ~= localPlayer then
                local function setupCharacter(char)
                    if not char:FindFirstChild("CustomRedESP") then
                        local hl = Instance.new("Highlight")
                        hl.Name = "CustomRedESP"
                        hl.FillColor = Color3.fromRGB(255, 0, 0)
                        hl.FillTransparency = 0.5
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.OutlineTransparency = 0
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Parent = char
                    end

                    local rootPart = char:FindFirstChild("HumanoidRootPart")
                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    if rootPart and humanoid and not char:FindFirstChild("VerticalHealthESP") then
                        local bg = Instance.new("BillboardGui")
                        bg.Name = "VerticalHealthESP"
                        bg.Size = UDim2.new(0, 30, 0, 70)
                        bg.StudsOffset = Vector3.new(2.2, 0, 0)
                        bg.AlwaysOnTop = true
                        bg.Parent = char

                        local bgBar = Instance.new("Frame")
                        bgBar.Size = UDim2.new(0, 6, 1, 0)
                        bgBar.Position = UDim2.new(0.5, -3, 0, 0)
                        bgBar.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                        bgBar.BorderSizePixel = 0
                        bgBar.Parent = bg

                        local bgCorner = Instance.new("UICorner")
                        bgCorner.CornerRadius = UDim.new(1, 0)
                        bgCorner.Parent = bgBar

                        local fillBar = Instance.new("Frame")
                        fillBar.Size = UDim2.new(1, 0, 1, 0)
                        fillBar.Position = UDim2.new(0, 0, 0, 0)
                        fillBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
                        fillBar.BorderSizePixel = 0
                        fillBar.Parent = bgBar

                        local fillCorner = Instance.new("UICorner")
                        fillCorner.CornerRadius = UDim.new(1, 0)
                        fillCorner.Parent = fillBar

                        local hbLoop = runService.RenderStepped:Connect(function()
                            if humanoid and humanoid.Health > 0 then
                                local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                                fillBar.Size = UDim2.new(1, 0, healthPercent, 0)
                                fillBar.Position = UDim2.new(0, 0, 1 - healthPercent, 0)
                                
                                if healthPercent > 0.5 then
                                    fillBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
                                elseif healthPercent > 0.25 then
                                    fillBar.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
                                else
                                    fillBar.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                                end
                            else
                                bg.Enabled = false
                            end
                        end)
                        table.insert(healthBarLoops, hbLoop)
                    end
                end

                if p.Character then
                    setupCharacter(p.Character)
                end
                table.insert(espConnections, p.CharacterAdded:Connect(setupCharacter))
            end
        end

        for _, p in ipairs(players:GetPlayers()) do
            applyESP(p)
        end
        table.insert(espConnections, players.PlayerAdded:Connect(applyESP))
    else
        espBtn.BackgroundColor3 = Color3.fromRGB(60, 40, 100)
        for _, conn in ipairs(espConnections) do
            if typeof(conn) == "RBXScriptConnection" then conn:Disconnect() end
        end
        espConnections = {}

        for _, loop in ipairs(healthBarLoops) do
            if typeof(loop) == "RBXScriptConnection" then loop:Disconnect() end
        end
        healthBarLoops = {}

        for _, p in ipairs(players:GetPlayers()) do
            if p.Character then
                local hl = p.Character:FindFirstChild("CustomRedESP")
                if hl then hl:Destroy() end
                local vh = p.Character:FindFirstChild("VerticalHealthESP")
                if vh then vh:Destroy() end
            end
        end
    end
end)


local itemTagCorner = Instance.new("UICorner")
itemTagCorner.CornerRadius = UDim.new(0, 6)
itemTagCorner.Parent = itemTagBtn

local isItemTagActive = false
local itemTagConnections = {}

local function getPlayerItemsString(p)
    local itemsFound = {}
    local containers = {}
    if p.Character then table.insert(containers, p.Character) end
    local backpack = p:FindFirstChildOfClass("Backpack")
    if backpack then table.insert(containers, backpack) end

    for _, container in ipairs(containers) do
        for _, item in ipairs(container:GetChildren()) do
            for _, targetName in ipairs(targetItems) do
                if string.lower(item.Name) == string.lower(targetName) then
                    table.insert(itemsFound, item.Name)
                end
            end
        end
    end
    return #itemsFound > 0 and table.concat(itemsFound, ", ") or "ไม่มีไอเทมเป้าหมาย"
end

itemTagBtn.MouseButton1Click:Connect(function()
    isItemTagActive = not isItemTagActive
    if isItemTagActive then
        itemTagBtn.BackgroundColor3 = Color3.fromRGB(100, 40, 150)
        
        local function applyItemTag(p)
            if p ~= localPlayer then
                local function setupCharTag(char)
                    local rootPart = char:FindFirstChild("HumanoidRootPart")
                    if rootPart and not char:FindFirstChild("ItemFootTagCustom") then
                        local bg = Instance.new("BillboardGui")
                        bg.Name = "ItemFootTagCustom"
                        bg.Size = UDim2.new(0, 200, 0, 50)
                        bg.StudsOffset = Vector3.new(0, -3.5, 0)
                        bg.AlwaysOnTop = true
                        bg.Parent = char

                        local txt = Instance.new("TextLabel")
                        txt.Size = UDim2.new(1, 0, 1, 0)
                        txt.BackgroundTransparency = 1
                        txt.TextColor3 = Color3.fromRGB(0, 255, 255)
                        txt.TextStrokeTransparency = 0
                        txt.TextSize = 12
                        txt.Font = Enum.Font.SourceSansBold
                        txt.Text = "กำลังโหลด..."
                        txt.Parent = bg

                        local taskLoop = task.spawn(function()
                            while char and char.Parent and isItemTagActive do
                                txt.Text = "📦 " .. getPlayerItemsString(p)
                                task.wait(1)
                            end
                        end)
                        table.insert(itemTagConnections, taskLoop)
                    end
                end
                if p.Character then setupCharTag(p.Character) end
                table.insert(itemTagConnections, p.CharacterAdded:Connect(setupCharTag))
            end
        end

        for _, p in ipairs(players:GetPlayers()) do applyItemTag(p) end
        table.insert(itemTagConnections, players.PlayerAdded:Connect(applyItemTag))
    else
        itemTagBtn.BackgroundColor3 = Color3.fromRGB(60, 40, 100)
        for _, p in ipairs(players:GetPlayers()) do
            if p.Character then
                local tag = p.Character:FindFirstChild("ItemFootTagCustom")
                if tag then tag:Destroy() end
            end
        end
    end
end)


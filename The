-- AUTO FISHING LOOP
task.spawn(function()
    while running and gui.Parent do
        task.wait(3)

        if autoFishing and running and gui.Parent then
            fishCount += 1
            status.Text = "สถานะ: ได้ปลา 1 ตัว!"
            update()
        end
    end
end)


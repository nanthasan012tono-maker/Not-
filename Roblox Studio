-- ระบบกดปุ่มซ่อน/แสดงเมนู (ขนาดเล็กกะทัดรัดตอนปิด)
local isMenuOpen = true
toggleMenuBtn.MouseButton1Click:Connect(function()
    isMenuOpen = not isMenuOpen
    for _, child in ipairs(mainFrame:GetChildren()) do
        if child:IsA("GuiObject") and child ~= titleLabel and child ~= toggleMenuBtn then
            child.Visible = isMenuOpen
        end
    end
    if isMenuOpen then
        toggleMenuBtn.Text = "-"
        if passwordBox.Visible or loginBtn.Visible then
            mainFrame.Size = UDim2.new(0, 240, 0, 210)
        else
            mainFrame.Size = UDim2.new(0, 240, 0, 195)
        end
    else
        toggleMenuBtn.Text = "+"
        mainFrame.Size = UDim2.new(0, 240, 0, 40) -- เหลือแค่แถบหัวข้อเล็กๆ ไม่บังจอ
    end
end)

-- ==========================================
-- 4. ลูปการทำงานเบื้องหลัง (Heartbeat)
-- ==========================================
RunService.Heartbeat:Connect(function()
	if FarmConfig.LockNPC then
		if not currentTarget or not currentTarget.Parent or (currentTarget.Position - camera.CFrame.Position).Magnitude > FarmConfig.MaxDistance then
			currentTarget = getClosestFarmNPCHead()
		end

		if currentTarget then
			camera.CFrame = CFrame.new(camera.CFrame.Position, currentTarget.Position)
		end
	end

	if FarmConfig.AutoShoot and FarmConfig.LockNPC and currentTarget then
		local tickTime = tick()
		if tickTime - lastShotTime >= FarmConfig.ShootDelay then
			lastShotTime = tickTime
			triggerShoot()
		end
	end

	updateSkeletonESP()
end)

-- ==========================================
-- 5. การจัดการปุ่มยืนยันคีย์และระบบตรวจสอบอัตโนมัติ
-- ==========================================
verifyBtn.MouseButton1Click:Connect(function()
	local duration, keyType = checkKeyInDatabase(keyBox.Text)
	if duration > 0 then
		saveKeySession(duration)
		keyOverlay:Destroy()
		buildFarmHub()
		print("✅ ปลดล็อกสำเร็จ! ประเภทคีย์: " .. keyType)
	else
		errorNotice.Text = "❌ คีย์ไม่ถูกต้องหรือไม่มีในระบบ"
		errorNotice.Visible = true
		task.delay(2.5, function()
			if errorNotice then errorNotice.Visible = false end
		end)
	end
end)

keyBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		verifyBtn:Activate()
	end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.KeyCode == FarmConfig.MenuKey then
		if mainFrame then
			FarmConfig.MenuVisible = not FarmConfig.MenuVisible
			mainFrame.Visible = FarmConfig.MenuVisible
		end
	end
end)

-- ตรวจสอบสิทธิ์อัตโนมัติเมื่อเปิดสคริปต์ครั้งแรก
if checkExistingSession() then
	keyOverlay:Destroy()
	buildFarmHub()
	print("🔓 ยินดีต้อนรับกลับมา! สิทธิ์การใช้งานยังไม่หมดอายุ")
end

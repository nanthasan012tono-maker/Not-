local function getWeaponInfo(toolName)
	local lowerName = string.lower(toolName)
	for weaponName, data in pairs(WeaponDatabase) do
		if string.find(lowerName, string.lower(weaponName), 1, true) then
			return weaponName, data.Tier, data.Color
		end
	end
	return toolName, "ITEM", Color3.fromRGB(255, 255, 255)
end


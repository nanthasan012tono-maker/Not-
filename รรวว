-- ฟังก์ชันสร้างปุ่มสลับ (ปิด = วงกลม / เปิด = สี่เหลี่ยมโค้งมน)
local function createToggleOption(name, yPos, defaultState, callback)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -24, 0, 40)
    container.Position = UDim2.new(0, 12, 0, yPos)
    container.BackgroundTransparency = 1
    container.Parent = MainFrame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 250, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = "> " .. name
    label.TextColor3 = Color3.fromRGB(210, 210, 210)
    label.TextSize = 14
    label.Font = Enum.Font.SourceSans
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container

    local switchBg = Instance.new("TextButton")
    switchBg.Size = UDim2.new(0, 44, 0, 22)
    switchBg.Position = UDim2.new(1, -44, 0.5, -11)
    switchBg.BackgroundColor3 = defaultState and Color3.fromRGB(150, 90, 240) or Color3.fromRGB(45, 40, 60)
    switchBg.Text = ""
    switchBg.Parent = container

    local UICornerSwitch = Instance.new("UICorner")
    UICornerSwitch.CornerRadius = UDim.new(1, 0)
    UICornerSwitch.Parent = switchBg

    -- ตัวปุ่มด้านใน (เปลี่ยนรูปทรงระหว่างวงกลมกับสี่เหลี่ยม)
    local innerBox = Instance.new("Frame")
    innerBox.Size = defaultState and UDim2.new(0, 18, 0, 16) or UDim2.new(0, 16, 0, 16)
    innerBox.Position = defaultState and UDim2.new(1, -21, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
    innerBox.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    innerBox.Parent = switchBg

    local UICornerBox = Instance.new("UICorner")
    -- ถ้าเปิดเป็นสี่เหลี่ยมโค้งมนเล็กน้อย (Radius = 4) / ถ้าปิดเป็นวงกลม (Radius = 1 หรือ 0.5)
    UICornerBox.CornerRadius = defaultState and UDim.new(0, 4) or UDim.new(1, 0)
    UICornerBox.Parent = innerBox

    local state = defaultState
    switchBg.MouseButton1Click:Connect(function()
        state = not state
        if state then
            -- เปิด: เปลี่ยนสี เปลี่ยนเป็นสี่เหลี่ยมโค้งมน และขยับไปขวา
            switchBg.BackgroundColor3 = Color3.fromRGB(150, 90, 240)
            UICornerBox.CornerRadius = UDim.new(0, 4)
            innerBox:TweenSizeAndPosition(UDim2.new(0, 18, 0, 16), UDim2.new(1, -21, 0.5, -8), "Out", "Quad", 0.15, true)
        else
            -- ปิด: เปลี่ยนสี เปลี่ยนเป็นวงกลม และขยับมาซ้าย
            switchBg.BackgroundColor3 = Color3.fromRGB(45, 40, 60)
            UICornerBox.CornerRadius = UDim.new(1, 0)
            innerBox:TweenSizeAndPosition(UDim2.new(0, 16, 0, 16), UDim2.new(0, 3, 0.5, -8), "Out", "Quad", 0.15, true)
        end
        callback(state)
    end)
end

-- กดเปิด/ปิดเมนูหลัก
ToggleButton.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

-- ตัวแปรควบคุมฟังก์ชันป้ายต่างๆ
_G.nameTagOn = true
_G.headTagOn = true
_G.footTagOn = true

createToggleOption("Name Tag (ป้ายชื่อหัว)", 45, _G.nameTagOn, function(state)
    _G.nameTagOn = state
end)

createToggleOption("Head Tag (ป้ายของดีที่สุด)", 95, _G.headTagOn, function(state)
    _G.headTagOn = state
end)

createToggleOption("Foot Tag (ป้ายไอเทมใต้เท้า)", 145, _G.footTagOn, function(state)
    _G.footTagOn = state
end)

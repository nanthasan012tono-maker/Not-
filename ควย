	local function createNewToggle(text, yPos, callback)
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0.9, 0, 0, 32)
		btn.Position = UDim2.new(0.05, 0, 0, yPos)
		btn.BackgroundColor3 = Color3.fromRGB(32, 22, 22)
		btn.Text = text .. " [OFF]"
		btn.TextColor3 = Color3.fromRGB(180, 180, 180)
		btn.Font = Enum.Font.GothamSemibold
		btn.TextSize = 11
		btn.Parent = mainFrame

		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 6)
		c.Parent = btn

		local state = false
		btn.MouseButton1Click:Connect(function()
			state = not state
			btn.Text = text .. (state and " [ON]" or " [OFF]")
			btn.TextColor3 = state and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(180, 180, 180)
			btn.BackgroundColor3 = state and Color3.fromRGB(50, 20, 20) or Color3.fromRGB(32, 22, 22)
			callback(state)
		end)
		return btn
	end

	createNewToggle("🎯 ล็อกเฉพาะ NPC ที่กำลังยืนอยู่ (ไม่ล็อกตัวล้ม/ตาย)", 48, function(active)
		FarmConfig.LockNPC = active
		if not active then currentTarget = nil end
	end)

	createNewToggle("💀 มองโครงกระดูก (Fix Respawn ESP)", 86, function(active)
		FarmConfig.SkeletonESP = active
		if not active then
			for _, folder in pairs(activeSkeletons) do
				if folder then folder:Destroy() end
			end
			table.clear(activeSkeletons)
		end
	end)

	-- ==========================================
	-- 3. ลูปการทำงานระบบ
	-- ==========================================
	RunService.RenderStepped:Connect(function()
		local character = localPlayer.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")

		if not rootPart then return end

		-- ระบบล็อกเป้าเฉพาะ NPC ที่ยืนอยู่จริง (ไม่ล็อกตัวที่ตายหรือล้ม)
		if FarmConfig.LockNPC then
			-- ฟังก์ชันเช็คว่ามองเห็นและไม่มีกำแพงกั้น
			local function isVisible(targetPart)
				local origin = camera.CFrame.Position
				local direction = targetPart.Position - origin
				local params = RaycastParams.new()
				params.FilterType = Enum.RaycastFilterType.Exclude
				params.FilterDescendantsInstances = {character, targetPart.Parent}
				params.IgnoreWater = true
				
				local result = Workspace:Raycast(origin, direction, params)
				if result == nil then
					return true
				elseif result.Instance and result.Instance:IsDescendantOf(targetPart.Parent) then
					return true
				end
				return false
			end

			-- ตรวจสอบเป้าหมายเดิม: ถ้าตาย เลือดหมด (<= 5) หรือล้ม/นั่ง ให้รีเซ็ตทันที
			if not currentTarget or not currentTarget.Parent or not currentTarget.Parent:FindFirstChildOfClass("Humanoid") then
				currentTarget = nil
			else
				local hum = currentTarget.Parent:FindFirstChildOfClass("Humanoid")
				if hum.Health <= 5 or hum.PlatformStand or hum.Sit or not isVisible(currentTarget) then
					currentTarget = nil
				end
			end

			-- ค้นหาเป้าหมายใหม่ที่ดีที่สุด (เฉพาะตัวที่ยืนอยู่, เลือด > 5, ไม่ล้ม และมองเห็น)
			if not currentTarget then
				local nearestDist = FarmConfig.MaxDistance
				local bestTarget = nil

				for _, obj in ipairs(Workspace:GetDescendants()) do
					if obj:IsA("Model") and obj ~= character then
						local humanoid = obj:FindFirstChildOfClass("Humanoid")
						local head = obj:FindFirstChild("Head") or obj:FindFirstChild("HumanoidRootPart")
						
						-- เงื่อนไขเข้มงวด: ต้องมีชีวิตอยู่จริง, ไม่ล้ม, ไม่ใช่ Player และต้องมองเห็นได้ไม่ทะลุกำแพง
						if humanoid and humanoid.Health > 5 and head and not Players:GetPlayerFromCharacter(obj) then
							if not humanoid.PlatformStand and not humanoid.Sit then
								local dist = (rootPart.Position - head.Position).Magnitude
								if dist < nearestDist and isVisible(head) then
									nearestDist = dist
									bestTarget = head
								end
							end
						end
					end
				end
				currentTarget = bestTarget
			end

			-- ทำการล็อกกล้องไปที่เป้าหมาย
			if currentTarget and currentTarget.Parent then
				local targetCFrame = CFrame.new(camera.CFrame.Position, currentTarget.Position)
				local smoothVal = math.clamp(FarmConfig.Smoothness, 1, 8)
				if smoothVal == 1 then
					camera.CFrame = targetCFrame
				else
					camera.CFrame = camera.CFrame:Lerp(targetCFrame, 1 / smoothVal)
				end
			else
				currentTarget = nil
			end
		end

		-- ระบบโครงกระดูก ESP แบบไม่บัคตอนเกิดใหม่
		if FarmConfig.SkeletonESP then
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= localPlayer then
					local pChar = p.Character
					if pChar and pChar:FindFirstChild("Humanoid") and pChar.Humanoid.Health > 0 then
						local head = pChar:FindFirstChild("Head")
						local torso = pChar:FindFirstChild("HumanoidRootPart") or pChar:FindFirstChild("UpperTorso")
						local la = pChar:FindFirstChild("Left Arm") or pChar:FindFirstChild("LeftUpperArm")
						local ra = pChar:FindFirstChild("Right Arm") or pChar:FindFirstChild("RightUpperArm")
						local ll = pChar:FindFirstChild("Left Leg") or pChar:FindFirstChild("LeftLowerLeg")
						local rl = pChar:FindFirstChild("Right Leg") or pChar:FindFirstChild("RightLowerLeg")

						if head and torso then
							local skelFolder = activeSkeletons[p]
							if not skelFolder or not skelFolder.Parent then
								skelFolder = Instance.new("Folder")
								skelFolder.Name = "FixedSkeleton"
								skelFolder.Parent = pChar
								activeSkeletons[p] = skelFolder
							end

							skelFolder:ClearAllChildren()

							local function createBoneLine(partA, partB)
								if not partA or not partB then return end
								local adorn = Instance.new("CylinderHandleAdornment")
								adorn.Adornee = partA
								adorn.Color3 = Color3.fromRGB(255, 50, 50)
								adorn.Transparency = 0.2
								adorn.Radius = 0.08
								adorn.AlwaysOnTop = true
								adorn.ZIndex = 10
								adorn.CFrame = partA.CFrame:Inverse() * CFrame.new(partA.Position, partB.Position)
								adorn.Height = (partA.Position - partB.Position).Magnitude
								adorn.Parent = skelFolder
							end

							createBoneLine(head, torso)
							if la then createBoneLine(torso, la) end
							if ra then createBoneLine(torso, ra) end
							if ll then createBoneLine(torso, ll) end
							if rl then createBoneLine(torso, rl) end
						end
					else
						if activeSkeletons[p] then
							activeSkeletons[p]:Destroy()
							activeSkeletons[p] = nil
						end
					end
				end
			end
		else
			for _, folder in pairs(activeSkeletons) do
				if folder then folder:Destroy() end
			end
			table.clear(activeSkeletons)
		end
	end)
end

-- ==========================================
-- 4. ยืนยันคีย์ (Key = 1)
-- ==========================================
local function verifyKeyAction()
	local inputVal = keyBox.Text:gsub("^%s*(.-)%s*$", "%1")
	if inputVal == FarmConfig.Key then
		keyOverlay:Destroy()
		buildFarmHub()
	else
		errorNotice.Visible = true
		keyBox.BackgroundColor3 = Color3.fromRGB(50, 25, 25)
	end
end

verifyBtn.MouseButton1Click:Connect(verifyKeyAction)
keyBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then verifyKeyAction() end
end)

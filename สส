espBtn.TextSize = 14
espBtn.Font = Enum.Font.SourceSansBold
espBtn.Parent = contentContainer

local espCorner = Instance.new("UICorner")
espCorner.CornerRadius = UDim.new(0, 6)
espCorner.Parent = espBtn

local isEspActive = false
local espHighlights = {}

espBtn.MouseButton1Click:Connect(function()
    isEspActive = not isEspActive
    if isEspActive then
        espBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        for _, p in ipairs(players:GetPlayers()) do
            if p ~= localPlayer and p.Character then
                local hl = Instance.new("Highlight")
                hl.Name = "CustomRedESP"
                hl.FillColor = Color3.fromRGB(255, 0, 0) -- ไส้ในสีแดง
                hl.FillTransparency = 0.5
                hl.OutlineColor = Color3.fromRGB(255, 255, 255) -- ขอบสีขาวตัดเด่นชัด
                hl.OutlineTransparency = 0
                hl.Parent = p.Character
                table.insert(espHighlights, hl)
            end
        end
    else
        espBtn.BackgroundColor3 = Color3.fromRGB(60, 40, 100)
        for _, hl in ipairs(espHighlights) do
            if hl then hl:Destroy() end
        end
        espHighlights = {}
    end
end)


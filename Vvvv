-- ==========================================
-- ฟังก์ชันตรวจสอบคีย์
-- ==========================================
local function verifyAndConsumeKey(inputKey)
	-- เช็ค Owner Key (ใช้ซ้ำได้หลายคน ไม่ลบออกจากระบบ)
	if inputKey == DatabaseKeys.OwnerKey then
		return 3153600000, "คีย์มาสเตอร์เจ้าของ (ใช้ซ้ำได้หลายคน)"
	end
	
	-- เช็คคีย์ถาวร 100 ปี (ใช้แล้วลบทิ้ง 1 คนต่อ 1 คีย์)
	for i, k in ipairs(DatabaseKeys.PermanentKeys) do
		if k == inputKey then
			table.remove(DatabaseKeys.PermanentKeys, i)
			return 3153600000, "คีย์ถาวร 100 ปี"
		end
	end
	
	-- เช็คคีย์รายวัน
	for i, k in ipairs(DatabaseKeys.DayKeys) do
		if k == inputKey then
			table.remove(DatabaseKeys.DayKeys, i)
			return 86400, "1 วัน"
		end
	end
	
	-- เช็คคีย์รายชั่วโมง
	for i, k in ipairs(DatabaseKeys.HourKeys) do
		if k == inputKey then
			table.remove(DatabaseKeys.HourKeys, i)
			return 3600, "1 ชั่วโมง"
		end
	end
	
	return 0, nil
end

local function saveKeySession(duration)
	local expireTime = os.time() + duration
	pcall(function() writefile(KEY_FILE_NAME, HttpService:JSONEncode({ ExpireAt = expireTime })) end)
end

local function checkExistingSession()
	if not pcall(function() readfile(KEY_FILE_NAME) end) then return false end
	local success, result = pcall(function() return HttpService:JSONDecode(readfile(KEY_FILE_NAME)) end)
	if success and result and result.ExpireAt then
		if result.ExpireAt - os.time() > 0 then return true
		else
			pcall(function() delfile(KEY_FILE_NAME) end)
			return false
		end
	end
	return false
end


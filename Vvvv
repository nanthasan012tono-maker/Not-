-- 2. ระบบฟาร์มและค้นหาเป้าหมาย (กรองเส้นเขียว)
-- ==========================================
local function getClosestFarmNPCHead()
	local closestHead = nil
	local shortestDist = FarmConfig.MaxDistance
	local myChar = localPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
	local myRoot = myChar.HumanoidRootPart

	for _, obj in pairs(Workspace:GetDescendants()) do
		if obj:IsA("Model") and obj ~= myChar then
			local isPlayer = Players:GetPlayerFromCharacter(obj)
			if not isPlayer then
				local humanoid = obj:FindFirstChildOfClass("Humanoid")
				local head = obj:FindFirstChild("Head")

				if humanoid and humanoid.Health > 0 and head then
					local hasGreenHighlight = false
					for _, child in ipairs(obj:GetChildren()) do
						if child:IsA("Highlight") then
							if child.FillColor.G > 0.5 or child.OutlineColor.G > 0.5 then
								hasGreenHighlight = true
								break
							end
						end
					end

					if not hasGreenHighlight then
						local dist = (head.Position - myRoot.Position).Magnitude
						if dist < shortestDist then
							shortestDist = dist
							closestHead = head
						end
					end
				end
			end
		end
	end
	return closestHead
end

local function triggerShoot()
	local char = localPlayer.Character
	if not char then return end
	local tool = char:FindFirstChildOfClass("Tool")
	if tool then pcall(function() tool:Activate() end) end
end

local function updateSkeletonESP()
	for model, lines in pairs(activeSkeletons) do
		if not model or not model.Parent or not model:FindFirstChildOfClass("Humanoid") or model:FindFirstChildOfClass("Humanoid").Health <= 0 then
			for _, line in pairs(lines) do line:Remove() end
			activeSkeletons[model] = nil
		end
	end

	if not FarmConfig.SkeletonESP then return end

	for _, obj in pairs(Workspace:GetDescendants()) do
		if obj:IsA("Model") and obj ~= localPlayer.Character then
			local isPlayer = Players:GetPlayerFromCharacter(obj)
			if not isPlayer then
				local humanoid = obj:FindFirstChildOfClass("Humanoid")
				local head = obj:FindFirstChild("Head")
				local root = obj:FindFirstChild("HumanoidRootPart")

				if humanoid and humanoid.Health > 0 and head and root then
					if not activeSkeletons[obj] then
						local line = Drawing.new("Line")
						line.Visible = false
						line.Color = Color3.fromRGB(255, 60, 60)
						line.Thickness = 1.5
						activeSkeletons[obj] = {line}
					end

					local headPos, onScreen1 = camera:WorldToViewportPoint(head.Position)
					local rootPos, onScreen2 = camera:WorldToViewportPoint(root.Position)
					local lines = activeSkeletons[obj]
					if onScreen1 and onScreen2 and lines and lines[1] then
						lines[1].From = Vector2.new(headPos.X, headPos.Y)
						lines[1].To = Vector2.new(rootPos.X, rootPos.Y)
						lines[1].Visible = true
					elseif lines and lines[1] then
						lines[1].Visible = false
					end
				end
			end
		end
	end
end

